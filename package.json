{
  "name": "idle-js",
  "version": "0.0.1",
  "description": "Know when user is idle",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielstuff/idle-js.git"
  },
  "keywords": [],
  "author": "gabrielstuff <gabriel@soixantecircuits.fr>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gabrielstuff/idle-js/issues"
  },
  "homepage": "https://github.com/gabrielstuff/idle-js",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.1",
    "tsdown": "^0.13.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
